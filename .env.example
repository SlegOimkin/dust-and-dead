# Public deployment. The domain must already resolve to the server.
# ALLOWED_ORIGINS must also list Android/Capacitor WebView origins when APK
# clients connect: https://localhost,capacitor://localhost
SITE_ADDRESS=
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=

# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep it stable across restarts; changing it invalidates reconnect tokens.
RESUME_TOKEN_SECRET=

# Match/lobby timings (milliseconds).
AUTO_START_DELAY_MS=40000
START_ACK_TIMEOUT_MS=12000
RECONNECT_GRACE_MS=20000
HEARTBEAT_INTERVAL_MS=15000

# Admission, session and per-connection message limits.
CONNECTION_RATE_PER_SECOND=90
CONNECTION_RATE_BURST=180
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32
MAX_SESSIONS=512

# Connected one-player lobbies are evicted after this much inactivity. A
# disconnected player is governed by RECONNECT_GRACE_MS instead.
IDLE_LOBBY_TTL_MS=600000

# Each active match owns a Playwright browser context. Increase only after
# measuring CPU and memory on the target host.
MAX_MATCHES=4
WORKER_STARTUP_TIMEOUT_MS=45000
WORKER_SHUTDOWN_TIMEOUT_MS=5000
LOG_LEVEL=info
