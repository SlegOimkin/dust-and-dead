# Public deployment. The domain must already resolve to the server.
# ALLOWED_ORIGINS must also list Android/Capacitor WebView origins when APK
# clients connect: https://localhost,capacitor://localhost
SITE_ADDRESS=
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=

# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep it stable across restarts; changing it invalidates reconnect tokens.
RESUME_TOKEN_SECRET=

# Match/lobby timings (milliseconds).
AUTO_START_DELAY_MS=40000
START_ACK_TIMEOUT_MS=12000
RECONNECT_GRACE_MS=20000
HEARTBEAT_INTERVAL_MS=15000

# Admission, session and per-connection message limits.
CONNECTION_RATE_PER_SECOND=90
CONNECTION_RATE_BURST=180
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32
MAX_SESSIONS=512

# Connected one-player lobbies are evicted after this much inactivity. A
# disconnected player is governed by RECONNECT_GRACE_MS instead.
IDLE_LOBBY_TTL_MS=600000

# A finished match is returned to the lobby on its own after this long, so
# players idling on the results screen cannot hold a match slot forever.
POST_MATCH_AUTO_RETURN_MS=90000

# Where authoritative matches run. "node" (default) hosts matches in Node
# worker threads with no browser at all; "browser" is the original Playwright
# path, kept as a rollback. On the node runtime the authority now builds no
# menu scene, no shader-warmup proxies and no geometry vertex data (nothing is
# ever drawn), so a match costs ~40-70 MB when threads are shared (see
# MATCHES_PER_WORKER) or ~150 MB with a dedicated thread, at ~0.2-0.7 core.
MATCH_RUNTIME=node

# Match slots. Increase only after measuring on the target host.
MAX_MATCHES=4

# Node runtime only: how many matches share one worker thread. 1 = every match
# gets its own thread (max crash isolation, one core each). Raising it packs
# matches into fewer isolates so they share the ~50 MB parse cost of game.js +
# jsdom: measured 4 matches on one thread hold a steady 60 fps at ~60 MB per
# match — but they share one core and die together if the thread dies. 2 is a
# balanced default; use 4 to squeeze a RAM-constrained box.
MATCHES_PER_WORKER=2

# Node runtime only: V8 old-space cap per worker thread, multiplied by
# MATCHES_PER_WORKER. A match that outgrows it dies alone instead of taking
# the whole node down with an OOM kill.
WORKER_MAX_OLD_HEAP_MB=512

# Node runtime only: idle worker threads kept booted with the game already
# compiled. The first room after a quiet period then starts in ~1.5 s instead
# of ~5 s. Each spare idles at a few tens of MB; 0 disables.
WARM_SPARE_THREADS=1

# Extra Chromium switches, MATCH_RUNTIME=browser only (whitespace-separated).
# "--process-per-site" shares one renderer process between all matches:
# 15-20% less RAM, but one renderer crash then kills every running match.
WORKER_LAUNCH_ARGS=
WORKER_STARTUP_TIMEOUT_MS=45000
WORKER_SHUTDOWN_TIMEOUT_MS=5000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Region identity (deploy/compose.yml). Fill these in only for a multi-region
# deployment; an empty DIRECTOR_URL keeps this server standalone.
# REGION_PUBLIC_URL must be the address players can actually reach, not the
# container's internal port. REGION_PRIORITY breaks ties before latency does;
# lower wins.
# ---------------------------------------------------------------------------
REGION_ID=
REGION_LABEL=
REGION_PUBLIC_URL=
REGION_PRIORITY=0
DIRECTOR_URL=
REGION_HEARTBEAT_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# Region director (deploy/compose.director.yml). DIRECTOR_TOKEN is shared: the
# director validates it, every region presents it. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
DIRECTOR_SITE_ADDRESS=
DIRECTOR_TOKEN=

# Optional JSON array pre-seeding the region list before the first heartbeat.
# Entries stay unverified (and unroutable) until the region actually reports in.
# REGIONS=[{"id":"eu-central","label":"Europe","url":"wss://eu.example.com/online"}]
REGIONS=

# A region disappears from the routable set this long after its last heartbeat.
REGION_TTL_MS=45000
# How long a client may cache the region list, and how long a search code stays
# pinned to a region on a client claim alone.
REGIONS_CACHE_TTL_MS=30000
ROUTE_CLAIM_TTL_MS=90000
MAX_ROUTE_CLAIMS=4096
MAX_REGIONS=64
DIRECTOR_RATE_PER_SECOND=20
DIRECTOR_RATE_BURST=60
